{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gastos",
  "main": "server/index.ts",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "BETTER_AUTH_URL": "https://gastos.crivaronicolini.com",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"],
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ChatAgent",
        "name": "ChatAgent",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ChatAgent"],
      "tag": "v1",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gastos-db",
      "database_id": "2af02b8f-c1d5-4c11-97ef-78daab8d818d",
      "migrations_dir": "./drizzle/d1",
    },
  ],
  "workflows": [
    {
      "name": "process-files",
      "binding": "process_files_WF",
      "class_name": "ProcessFilesWorkflow",
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "gastos",
      "binding": "R2",
    },
  ],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
}
